DATABASE_URL=postgresql://relay:relay_local@127.0.0.1:54329/relay
UPLOAD_DIR=.data/uploads
RELAY_DEMO_MODE=true
DEMO_PASSWORD=relay-local-only
# C# worker uses this format (Next.js uses DATABASE_URL above).
ConnectionStrings__Relay=Host=127.0.0.1;Port=54329;Database=relay;Username=relay;Password=relay_local
Relay__UploadDir=.data/uploads
Relay__BatchSize=500
Relay__BatchDelayMs=0
# Failure injection is off by default. See upskilling/labs/04-recovery.md.
Relay__CrashAfterRows=0

# Private local services. Use random secrets and private URLs for deployment.
RELAY_AI_URL=http://127.0.0.1:4319
RELAY_AI_KEY=relay-local-ai
RELAY_CONNECTOR_KEY=relay-local-connector
Relay__ConnectorUrl=http://127.0.0.1:4321
Relay__ConnectorKey=relay-local-connector
Relay__MaxSchema=2
Relay__CrashBeforeRows=0
Relay__CrashOnUncertain=false
